&CONTROL
calculation = 'relax' ,
restart_mode = 'restart' ,
outdir = './LiZn_100_2' ,
pseudo_dir = '../pseudos/' ,
prefix = 'LiZn_100_2' ,
max_seconds = 3550 ,
nstep = 500 ,
tstress = .true. ,
tprnfor = .true. ,
 /
&SYSTEM
ibrav = 0,
nat = 16,
ntyp = 2,
ecutwfc = 55 ,
ecutrho = 500 ,
occupations = 'smearing'
degauss = 0.03,
smearing = 'methfessel-paxton'
/
&ELECTRONS
conv_thr = 1.0d-6 ,
mixing_beta = 0.3 ,
diagonalization = 'david' ,
electron_maxstep = 200
 /
&IONS
ion_dynamics = 'bfgs' 
 /
CELL_PARAMETERS angstrom

ATOMIC_SPECIES

ATOMIC_POSITIONS (Angstrom)

K_POINTS automatic
4 4 1   0 0 0
